{% extends 'base.html.twig' %}

{% block title %}Connexion — SkillSwap{% endblock %}
{% block body_class %}page-auth{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/pages/auth.css">
{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <div class="auth-card card">

        <div class="auth-header">
            <a href="{{ path('app_home') }}" class="auth-logo">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                    <path d="M7 16L3 12L7 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M17 8L21 12L17 16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M14 4L10 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                SkillSwap
            </a>
            <h1 class="auth-title">Bienvenue !</h1>
            <p class="auth-subtitle">Connectez-vous pour accéder à votre espace</p>
        </div>


        {% if error %}
            <div class="alert alert-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <div id="loginError" class="alert alert-error" role="alert" style="display:none"></div>

        <form id="loginForm" method="post" action="{{ path('app_login') }}" class="auth-form" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <input type="hidden" name="_target_path" value="/feed">

            <div class="input-group">
                <label class="input-label" for="inputEmail">Email</label>
                <input
                    type="email"
                    id="inputEmail"
                    name="_username"
                    class="input-field"
                    placeholder="votre@email.fr"
                    autocomplete="email"
                    required
                    autofocus
                >
            </div>

            <div class="input-group">
                <label class="input-label" for="inputPassword">
                    Mot de passe
                    <a href="#" class="input-label-link">Mot de passe oublié ?</a>
                </label>
                <div class="input-password-wrapper">
                    <input
                        type="password"
                        id="inputPassword"
                        name="_password"
                        class="input-field"
                        placeholder="••••••••"
                        autocomplete="current-password"
                        required
                    >
                    <button type="button" class="input-toggle-password" aria-label="Afficher le mot de passe">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                    </button>
                </div>
            </div>

            <button type="submit" id="loginBtn" class="btn btn-primary btn-full">
                Se connecter
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
        </form>

        <div class="auth-footer">
            <p>Pas encore de compte ? <a href="{{ path('app_register') }}" class="auth-link">Créer un compte</a></p>
        </div>
    </div>

    <div class="auth-decoration" aria-hidden="true">
        <div class="auth-shape auth-shape--1"></div>
        <div class="auth-shape auth-shape--2"></div>
    </div>
</div>

<script src="/js/api.js"></script>
<script src="/js/auth.js"></script>
<script>
    document.querySelectorAll('.input-toggle-password').forEach(btn => {
        btn.addEventListener('click', () => {
            const input = btn.previousElementSibling;
            const isText = input.type === 'text';
            input.type = isText ? 'password' : 'text';
            btn.setAttribute('aria-label', isText ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
        });
    });

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email    = document.getElementById('inputEmail').value.trim();
        const password = document.getElementById('inputPassword').value;
        const btn      = document.getElementById('loginBtn');
        const errorEl  = document.getElementById('loginError');

        errorEl.style.display = 'none';
        btn.disabled = true;
        btn.textContent = 'Connexion…';

        // 1. Récupérer le JWT pour les appels API
        const result = await apiLogin(email, password);

        if (result.success) {
            // 2. Soumettre le formulaire normalement pour la session Symfony
            e.target.submit();
        } else {
            errorEl.textContent = result.error;
            errorEl.style.display = 'flex';
            btn.disabled = false;
            btn.innerHTML = 'Se connecter <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        }
    });
</script>
{% endblock %}
