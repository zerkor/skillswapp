{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Admin — SkillSwap{% endblock %}
{% block body_class %}page-admin{% endblock %}

{% block stylesheets %}
<style>
.admin-header { background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary)); color: white; padding: var(--spacing-8) 0; margin-bottom: var(--spacing-8); }
.admin-header h1 { color: white; font-size: var(--text-3xl); }
.admin-header p  { opacity: .8; margin-top: var(--spacing-2); }

.kpi-grid { display: grid; grid-template-columns: 1fr; gap: var(--spacing-6); margin-bottom: var(--spacing-8); }
@media(min-width:768px)  { .kpi-grid { grid-template-columns: repeat(3,1fr); } }

.kpi-card { background: white; border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--spacing-6); box-shadow: var(--shadow-card); }
.kpi-card--primary  { border-top: 4px solid var(--color-primary); }
.kpi-card--accent   { border-top: 4px solid var(--color-accent); }
.kpi-card--success  { border-top: 4px solid var(--color-success); }

.kpi-header { display:flex; align-items:center; justify-content:space-between; margin-bottom: var(--spacing-4); }
.kpi-icon { width:3rem; height:3rem; border-radius: var(--radius-lg); display:flex; align-items:center; justify-content:center; font-size:1.25rem; }
.kpi-icon--blue   { background: var(--color-primary-light); }
.kpi-icon--cyan   { background: var(--color-accent-light); }
.kpi-icon--green  { background: var(--color-success-light); }

.kpi-value { font-family: var(--font-heading); font-size: var(--text-5xl); font-weight: var(--font-extrabold); color: var(--color-primary); line-height:1; }
.kpi-card--accent  .kpi-value { color: #0E7490; }
.kpi-card--success .kpi-value { color: var(--color-success); }
.kpi-label { font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-text); margin: var(--spacing-2) 0 var(--spacing-4); }
.kpi-sub   { display:flex; flex-direction:column; gap:var(--spacing-2); }
.kpi-sub-item { display:flex; justify-content:space-between; font-size:var(--text-xs); color: var(--color-text-muted); padding: 0.25rem 0; border-bottom:1px solid var(--color-border); }
.kpi-sub-item:last-child { border:none; }
.kpi-sub-item strong { color: var(--color-text); font-weight: var(--font-semibold); }

.kpi-highlight { background: var(--color-primary-light); border-radius: var(--radius-md); padding: var(--spacing-3) var(--spacing-4); margin-top: var(--spacing-4); text-align:center; }
.kpi-highlight strong { font-size: var(--text-2xl); color: var(--color-success); font-family: var(--font-heading); font-weight: var(--font-extrabold); }
.kpi-highlight span   { display:block; font-size: var(--text-xs); color: var(--color-text-muted); margin-top:2px; }

.admin-body { display: grid; grid-template-columns: 1fr; gap: var(--spacing-6); }
@media(min-width:1024px) { .admin-body { grid-template-columns: 1fr 320px; } }

.admin-section-title { font-size: var(--text-xl); font-family: var(--font-heading); font-weight: var(--font-bold); margin-bottom: var(--spacing-4); display:flex; align-items:center; gap:var(--spacing-2); }

.eval-banner { background: linear-gradient(135deg, #FEF3C7, #FDE68A); border: 2px solid var(--color-warning); border-radius: var(--radius-xl); padding: var(--spacing-6); margin-bottom: var(--spacing-8); }
.eval-banner h2 { color: #92400E; font-size: var(--text-lg); margin-bottom: var(--spacing-3); display:flex; align-items:center; gap:var(--spacing-2); }
.eval-criteria { display:flex; flex-direction:column; gap:var(--spacing-2); }
.eval-item { display:flex; align-items:center; gap:var(--spacing-3); font-size:var(--text-sm); color:#92400E; }
.eval-item svg { flex-shrink:0; }
</style>
{% endblock %}

{% block body %}
<div class="admin-header">
    <div class="container">
        <h1>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" style="display:inline;vertical-align:middle;margin-right:.5rem"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/></svg>
            Tableau de bord
        </h1>
        <p>Vue d'ensemble des métriques SkillSwap — mis à jour en temps réel</p>
    </div>
</div>

<div class="container" style="padding-bottom: var(--spacing-12);">

    {# ═══ BANNIÈRE CRITÈRES FORMATEUR ═══ #}
    <div class="eval-banner">
        <h2>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#F59E0B" stroke="#F59E0B"/></svg>
            Critères d'évaluation formateur
        </h2>
        <div class="eval-criteria">
            <div class="eval-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke="#10B981" stroke-width="2.5" stroke-linecap="round"/><polyline points="22 4 12 14.01 9 11.01" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <strong>Critère 1 :</strong>&nbsp;Nombre d'inscriptions — {{ kpis.inscriptions.total }} comptes créés
            </div>
            <div class="eval-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke="#10B981" stroke-width="2.5" stroke-linecap="round"/><polyline points="22 4 12 14.01 9 11.01" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <strong>Critère 2 :</strong>&nbsp;Niveau d'utilisation — {{ kpis.utilisation.sessionsActives }} sessions actives
            </div>
            <div class="eval-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#F59E0B" stroke="#F59E0B" stroke-width="1"/></svg>
                <strong>Critère 3 (PRIORITÉ) :</strong>&nbsp;Mises en relation — {{ kpis.mises_en_relation.total }} connexions réalisées via le matching
            </div>
        </div>
    </div>

    {# ═══ KPIs ═══ #}
    <div class="kpi-grid">

        {# KPI 1 — Inscriptions #}
        <div class="kpi-card kpi-card--primary">
            <div class="kpi-header">
                <div>
                    <div class="kpi-value">{{ kpis.inscriptions.total }}</div>
                    <div class="kpi-label">Inscriptions totales</div>
                </div>
                <div class="kpi-icon kpi-icon--blue">👥</div>
            </div>
            <div class="kpi-sub">
                <div class="kpi-sub-item">
                    <span>Comptes vérifiés</span>
                    <strong>{{ kpis.inscriptions.verified }}</strong>
                </div>
                <div class="kpi-sub-item">
                    <span>Nouveaux (30 jours)</span>
                    <strong>{{ kpis.inscriptions.last30days }}</strong>
                </div>
                <div class="kpi-sub-item">
                    <span>Nouveaux (7 jours)</span>
                    <strong>{{ kpis.inscriptions.last7days }}</strong>
                </div>
            </div>
        </div>

        {# KPI 2 — Utilisation #}
        <div class="kpi-card kpi-card--accent">
            <div class="kpi-header">
                <div>
                    <div class="kpi-value">{{ kpis.utilisation.sessionsActives }}</div>
                    <div class="kpi-label">Sessions actives</div>
                </div>
                <div class="kpi-icon kpi-icon--cyan">⚡</div>
            </div>
            <div class="kpi-sub">
                <div class="kpi-sub-item">
                    <span>Sessions (30 jours)</span>
                    <strong>{{ kpis.utilisation.sessionsLast30j }}</strong>
                </div>
                <div class="kpi-sub-item">
                    <span>Posts publiés</span>
                    <strong>{{ kpis.utilisation.postsTotal }}</strong>
                </div>
                <div class="kpi-sub-item">
                    <span>Avis déposés</span>
                    <strong>{{ kpis.utilisation.reviewsTotal }}</strong>
                </div>
            </div>
        </div>

        {# KPI 3 — Mises en relation (priorité absolue) #}
        <div class="kpi-card kpi-card--success">
            <div class="kpi-header">
                <div>
                    <div class="kpi-value">{{ kpis.mises_en_relation.total }}</div>
                    <div class="kpi-label">Mises en relation 🎯</div>
                </div>
                <div class="kpi-icon kpi-icon--green">🤝</div>
            </div>
            <div class="kpi-sub">
                <div class="kpi-sub-item">
                    <span>Sessions complétées</span>
                    <strong>{{ kpis.mises_en_relation.completees }}</strong>
                </div>
                <div class="kpi-sub-item">
                    <span>Sessions proposées</span>
                    <strong>{{ kpis.mises_en_relation.proposees }}</strong>
                </div>
            </div>
            <div class="kpi-highlight">
                <strong>{{ kpis.mises_en_relation.taux }}%</strong>
                <span>Taux de conversion (proposée → complétée)</span>
            </div>
        </div>
    </div>

    {# ═══ CORPS ═══ #}
    <div class="admin-body">
        <div>
            <div class="card">
                <h2 class="admin-section-title">🏆 Top 5 utilisateurs</h2>
                <table style="width:100%;border-collapse:collapse;">
                    <thead>
                        <tr style="border-bottom:2px solid var(--color-border);">
                            <th style="text-align:left;padding:.5rem;font-size:var(--text-xs);text-transform:uppercase;color:var(--color-text-muted);">Rang</th>
                            <th style="text-align:left;padding:.5rem;font-size:var(--text-xs);text-transform:uppercase;color:var(--color-text-muted);">Utilisateur</th>
                            <th style="text-align:left;padding:.5rem;font-size:var(--text-xs);text-transform:uppercase;color:var(--color-text-muted);">Niveau</th>
                            <th style="text-align:right;padding:.5rem;font-size:var(--text-xs);text-transform:uppercase;color:var(--color-text-muted);">Score</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in topUsers %}
                        <tr style="border-bottom:1px solid var(--color-border);">
                            <td style="padding:.75rem .5rem;font-weight:700;color:var(--color-primary);">{{ loop.index }}</td>
                            <td style="padding:.75rem .5rem;">
                                <a href="{{ path('app_profile_show', {id: user.id}) }}" style="font-weight:600;color:var(--color-text);">
                                    @{{ user.displayName }}
                                </a>
                            </td>
                            <td style="padding:.75rem .5rem;"><span class="badge-niveau {{ user.niveau }}">{{ user.niveau|capitalize }}</span></td>
                            <td style="padding:.75rem .5rem;text-align:right;font-family:var(--font-heading);font-weight:700;color:var(--color-primary);">{{ user.score }} pts</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                <div style="margin-top:var(--spacing-4);text-align:center;">
                    <a href="{{ path('app_leaderboard') }}" class="btn btn-ghost btn-sm">Voir le classement complet →</a>
                </div>
            </div>
        </div>

        <div>
            <div class="card">
                <h2 class="admin-section-title">🔗 Liens rapides</h2>
                <div style="display:flex;flex-direction:column;gap:var(--spacing-3);">
                    <a href="{{ path('app_search') }}" class="btn btn-secondary btn-sm">Moteur de matching</a>
                    <a href="{{ path('app_leaderboard') }}" class="btn btn-secondary btn-sm">Classement</a>
                    <a href="{{ path('app_feed') }}" class="btn btn-secondary btn-sm">Feed communautaire</a>
                    <a href="{{ path('app_sessions') }}" class="btn btn-secondary btn-sm">Mes sessions</a>
                </div>
            </div>

            <div class="card" style="margin-top:var(--spacing-4);">
                <h2 class="admin-section-title" style="font-size:var(--text-base);">📊 Santé de la plateforme</h2>
                {% set taux = kpis.mises_en_relation.taux %}
                <div style="margin-bottom:var(--spacing-3);">
                    <div style="display:flex;justify-content:space-between;font-size:var(--text-xs);margin-bottom:var(--spacing-1);">
                        <span>Taux de conversion sessions</span>
                        <strong>{{ taux }}%</strong>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width:{{ taux }}%;background:{% if taux >= 60 %}var(--color-success){% elseif taux >= 30 %}var(--color-warning){% else %}var(--color-error){% endif %}"></div>
                    </div>
                </div>
                {% set verifRate = kpis.inscriptions.total > 0 ? ((kpis.inscriptions.verified / kpis.inscriptions.total) * 100)|round : 0 %}
                <div>
                    <div style="display:flex;justify-content:space-between;font-size:var(--text-xs);margin-bottom:var(--spacing-1);">
                        <span>Comptes vérifiés</span>
                        <strong>{{ verifRate }}%</strong>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width:{{ verifRate }}%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
