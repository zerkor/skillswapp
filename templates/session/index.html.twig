{% extends 'base.html.twig' %}

{% block title %}Mes sessions — SkillSwap{% endblock %}
{% block body_class %}page-sessions{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/pages/session.css">
{% endblock %}

{% block body %}
<div class="container" style="padding: var(--spacing-8) var(--container-padding);">

    <div class="page-header">
        <h1>Mes sessions</h1>
        <a href="{{ path('app_sessions_new') }}" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            Nouvelle session
        </a>
    </div>

    <div class="sessions-tabs" role="tablist">
        <button class="tab-btn tab-btn--active" role="tab" aria-selected="true" aria-controls="tab-upcoming" data-filter="upcoming">
            À venir
        </button>
        <button class="tab-btn" role="tab" aria-selected="false" aria-controls="tab-active" data-filter="active">
            En cours
        </button>
        <button class="tab-btn" role="tab" aria-selected="false" aria-controls="tab-done" data-filter="done">
            Terminées
        </button>
        <button class="tab-btn" role="tab" aria-selected="false" aria-controls="tab-cancelled" data-filter="cancelled">
            Annulées
        </button>
    </div>

    <div id="sessionsContainer" class="sessions-grid">
        {% for session in sessions %}
            {% set isUpcoming  = session.statut in ['proposee', 'confirmee'] %}
            {% set isActive    = session.statut == 'en_cours' %}
            {% set isDone      = session.statut == 'completee' %}
            {% set isCancelled = session.statut == 'annulee' %}
            {% set isTuteur    = app.user.id == session.tuteur.id %}
            {% set partner     = isTuteur ? session.apprenant : session.tuteur %}

            <article
                class="session-card card"
                data-statut="{{ session.statut }}"
                data-filter="{{ isUpcoming ? 'upcoming' : (isActive ? 'active' : (isDone ? 'done' : 'cancelled')) }}"
            >
                <div class="session-card-header">
                    <div class="session-partners">
                        {% if session.tuteur.photo %}
                            <img src="{{ session.tuteur.photo }}" alt="{{ session.tuteur.fullName }}" class="avatar avatar-sm" title="Tuteur : {{ session.tuteur.fullName }}">
                        {% else %}
                            <div class="avatar avatar-sm avatar-placeholder">{{ session.tuteur.prenom|slice(0,1) }}{{ session.tuteur.nom|slice(0,1) }}</div>
                        {% endif %}
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="session-arrow" aria-hidden="true"><path d="M7 16L3 12L7 8M17 8L21 12L17 16M14 4L10 20" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {% if session.apprenant.photo %}
                            <img src="{{ session.apprenant.photo }}" alt="{{ session.apprenant.fullName }}" class="avatar avatar-sm" title="Apprenant : {{ session.apprenant.fullName }}">
                        {% else %}
                            <div class="avatar avatar-sm avatar-placeholder">{{ session.apprenant.prenom|slice(0,1) }}{{ session.apprenant.nom|slice(0,1) }}</div>
                        {% endif %}
                    </div>
                    <span class="statut-badge statut-badge--{{ session.statut }}">{{ session.statut|replace({'_': ' '})|capitalize }}</span>
                </div>

                <div class="session-card-body">
                    <h3 class="session-competence">{{ session.competence }}</h3>
                    <p class="session-partner-name">
                        {{ isTuteur ? 'Apprenant' : 'Tuteur' }} :
                        <a href="{{ path('app_profile_show', {id: partner.id}) }}">{{ partner.fullName }}</a>
                    </p>
                    <div class="session-meta">
                        <span class="session-type type-badge type-badge--{{ session.type }}">
                            {% if session.type == 'cours_rapide' %}Cours rapide{% elseif session.type == 'atelier' %}Atelier{% else %}Club{% endif %}
                        </span>
                        <span class="session-date">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                            {{ session.date|date('d/m/Y H:i') }}
                        </span>
                        <span class="session-duree">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><polyline points="12 6 12 12 16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            {{ session.dureeMinutes }} min
                        </span>
                    </div>
                    {% if session.lieuOuLien %}
                        <p class="session-lieu">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/></svg>
                            {{ session.lieuOuLien }}
                        </p>
                    {% endif %}
                </div>

                <div class="session-card-actions">
                    {% if session.statut == 'proposee' and isTuteur %}
                        <button class="btn btn-primary btn-sm" onclick="confirmSession({{ session.id }}, this)">Confirmer</button>
                        <button class="btn btn-danger btn-sm" onclick="declineSession({{ session.id }}, this)">Refuser</button>
                    {% elseif session.statut == 'proposee' and not isTuteur %}
                        <button class="btn btn-ghost btn-sm" onclick="cancelSession({{ session.id }}, this)">Annuler</button>
                    {% elseif session.statut == 'confirmee' %}
                        <button class="btn btn-success btn-sm" onclick="completeSession({{ session.id }}, this)">
                            Marquer complète
                        </button>
                        <button class="btn btn-ghost btn-sm" onclick="cancelSession({{ session.id }}, this)">Annuler</button>
                    {% elseif session.statut == 'completee' %}
                        <a href="#review-{{ session.id }}" class="btn btn-secondary btn-sm" onclick="showReviewForm({{ session.id }}, this)">
                            Laisser un avis
                        </a>
                    {% endif %}
                </div>

                {# Formulaire d'avis #}
                <div class="review-form" id="review-{{ session.id }}" style="display:none">
                    <h4>Votre avis</h4>
                    <div class="star-rating" data-session="{{ session.id }}">
                        {% for i in 1..5 %}
                            <button type="button" class="star-btn" data-value="{{ i }}" aria-label="{{ i }} étoile(s)">★</button>
                        {% endfor %}
                    </div>
                    <textarea class="input-field review-textarea" placeholder="Votre commentaire..." rows="3"></textarea>
                    <button class="btn btn-primary btn-sm" onclick="submitReview({{ session.id }}, this)">Publier l'avis</button>
                </div>
            </article>
        {% else %}
            <div class="empty-state-full">
                <div aria-hidden="true" style="font-size:3rem;">📅</div>
                <h3>Aucune session</h3>
                <p>Recherchez un tuteur et proposez votre première session !</p>
                <a href="{{ path('app_search') }}" class="btn btn-primary">Trouver un tuteur</a>
            </div>
        {% endfor %}
    </div>
</div>

<script src="/js/session.js"></script>
{% endblock %}
