{% extends 'base.html.twig' %}

{% block title %}Nouvelle session — SkillSwap{% endblock %}
{% block body_class %}page-session-new{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/pages/session.css">
{% endblock %}

{% block body %}
<div class="container" style="max-width:640px; padding: var(--spacing-8) var(--container-padding);">

    <div class="page-header">
        <a href="{{ path('app_sessions') }}" class="btn btn-ghost btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Retour
        </a>
        <h1>Proposer une session</h1>
    </div>

    <div id="sessionAlert" class="alert" role="alert" style="display:none"></div>

    <div class="card" style="padding:var(--spacing-8);">
        <div class="input-group">
            <label class="input-label" for="sessionTuteur">Tuteur</label>
            <input type="hidden" id="sessionTuteurId" value="">
            <input type="text" id="sessionTuteur" class="input-field" placeholder="Nom du tuteur" readonly>
            <p class="input-hint">Sélectionnez un tuteur depuis la <a href="{{ path('app_search') }}">recherche</a>.</p>
        </div>

        <div class="input-group">
            <label class="input-label" for="sessionCompetence">Compétence</label>
            <input type="text" id="sessionCompetence" class="input-field" placeholder="ex: Python, Photoshop..." required>
        </div>

        <div class="input-row">
            <div class="input-group">
                <label class="input-label" for="sessionType">Type de session</label>
                <select id="sessionType" class="input-field">
                    <option value="cours_rapide">Cours rapide</option>
                    <option value="atelier">Atelier</option>
                    <option value="club">Club</option>
                </select>
            </div>
            <div class="input-group">
                <label class="input-label" for="sessionDuree">Durée (minutes)</label>
                <input type="number" id="sessionDuree" class="input-field" value="60" min="15" max="480">
            </div>
        </div>

        <div class="input-group">
            <label class="input-label" for="sessionDate">Date et heure</label>
            <input type="datetime-local" id="sessionDate" class="input-field" required>
        </div>

        <div class="input-group">
            <label class="input-label" for="sessionLieu">Lieu ou lien (optionnel)</label>
            <input type="text" id="sessionLieu" class="input-field" placeholder="Salle B204 ou https://meet.google.com/...">
        </div>

        <div style="display:flex; gap:var(--spacing-3); justify-content:flex-end; margin-top:var(--spacing-6);">
            <a href="{{ path('app_sessions') }}" class="btn btn-ghost">Annuler</a>
            <button type="button" class="btn btn-primary" id="submitSession">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Envoyer la proposition
            </button>
        </div>
    </div>
</div>

<script src="/js/session.js"></script>
<script>
    // Pré-remplir le tuteur depuis l'URL ?tuteur=ID
    const params   = new URLSearchParams(window.location.search);
    const tuteurId = params.get('tuteur');
    if (tuteurId) {
        document.getElementById('sessionTuteurId').value = tuteurId;
        fetch(`/api/users/${tuteurId}`, { headers: getAuthHeaders() })
            .then(r => r.json())
            .then(json => {
                if (json.success) {
                    document.getElementById('sessionTuteur').value = json.data.fullName || `${json.data.prenom} ${json.data.nom}`;
                }
            });
    }

    document.getElementById('submitSession')?.addEventListener('click', async () => {
        const tuteurId  = document.getElementById('sessionTuteurId').value;
        const competence = document.getElementById('sessionCompetence').value.trim();
        const type      = document.getElementById('sessionType').value;
        const duree     = parseInt(document.getElementById('sessionDuree').value);
        const date      = document.getElementById('sessionDate').value;
        const lieu      = document.getElementById('sessionLieu').value;

        if (!tuteurId || !competence || !date) {
            showSessionAlert('error', 'Tuteur, compétence et date sont obligatoires.');
            return;
        }

        const res  = await apiFetch('/api/sessions', {
            method: 'POST',
            body: JSON.stringify({
                tuteur_id: parseInt(tuteurId),
                competence,
                type,
                date,
                duree_minutes: duree,
                lieu_ou_lien: lieu,
            })
        });
        const json = await res.json();
        if (json.success) {
            showSessionAlert('success', 'Session proposée ! En attente de confirmation.');
            setTimeout(() => window.location.href = '/sessions', 2000);
        } else {
            showSessionAlert('error', json.error);
        }
    });

    function showSessionAlert(type, msg) {
        const el = document.getElementById('sessionAlert');
        el.className = `alert alert-${type}`;
        el.textContent = msg;
        el.style.display = 'flex';
    }
</script>
{% endblock %}
