{% extends 'base.html.twig' %}

{% block title %}Nouvelle session — SkillSwap{% endblock %}
{% block body_class %}page-session-new{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/pages/session.css">
{% endblock %}

{% block body %}
<div class="container" style="max-width:640px; padding: var(--spacing-8) var(--container-padding);">

    <div class="page-header">
        <a href="{{ path('app_sessions') }}" class="btn btn-ghost btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Retour
        </a>
        <h1>Proposer une session</h1>
    </div>

    <div id="sessionAlert" class="alert" role="alert" style="display:none"></div>

    <div class="card" style="padding:var(--spacing-8);">
        <div class="input-group" style="position:relative">
            <label class="input-label" for="sessionTuteurSearch">Tuteur</label>
            <input type="hidden" id="sessionTuteurId" value="">
            <input type="text" id="sessionTuteur" style="display:none" readonly>
            <input type="text" id="sessionTuteurSearch" class="input-field" placeholder="Tapez une compétence pour trouver un tuteur…" autocomplete="off">
            <div id="tuteurDropdown" style="display:none; position:absolute; top:100%; left:0; right:0; background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-md); box-shadow:var(--shadow-lg); z-index:100; max-height:220px; overflow-y:auto;"></div>
            <p class="input-hint" id="tuteurHint">Recherchez par compétence pour trouver un tuteur disponible.</p>
        </div>

        <div class="input-group">
            <label class="input-label" for="sessionCompetence">Compétence</label>
            <input type="text" id="sessionCompetence" class="input-field" placeholder="ex: Python, Photoshop..." required>
        </div>

        <div class="input-row">
            <div class="input-group">
                <label class="input-label" for="sessionType">Type de session</label>
                <select id="sessionType" class="input-field">
                    <option value="cours_rapide">Cours rapide</option>
                    <option value="atelier">Atelier</option>
                    <option value="club">Club</option>
                </select>
            </div>
            <div class="input-group">
                <label class="input-label" for="sessionDuree">Durée (minutes)</label>
                <input type="number" id="sessionDuree" class="input-field" value="60" min="15" max="480">
            </div>
        </div>

        <div class="input-group">
            <label class="input-label" for="sessionDate">Date et heure</label>
            <input type="datetime-local" id="sessionDate" class="input-field" required>
        </div>

        <div class="input-group">
            <label class="input-label" for="sessionLieu">Lieu ou lien (optionnel)</label>
            <input type="text" id="sessionLieu" class="input-field" placeholder="Salle B204 ou https://meet.google.com/...">
        </div>

        <div style="display:flex; gap:var(--spacing-3); justify-content:flex-end; margin-top:var(--spacing-6);">
            <a href="{{ path('app_sessions') }}" class="btn btn-ghost">Annuler</a>
            <button type="button" class="btn btn-primary" id="submitSession">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Envoyer la proposition
            </button>
        </div>
    </div>
</div>

<script src="/js/session.js"></script>
<script>
    // Pré-remplir le tuteur depuis l'URL ?tuteur=ID (après chargement de api.js)
    document.addEventListener('DOMContentLoaded', () => {
        const params   = new URLSearchParams(window.location.search);
        const tuteurId = params.get('tuteur');
        if (tuteurId) {
            document.getElementById('sessionTuteurId').value = tuteurId;
            fetch(`/api/users/${tuteurId}`, { headers: getAuthHeaders() })
                .then(r => r.json())
                .then(json => {
                    if (json.success) {
                        const name = json.data.fullName || `${json.data.prenom} ${json.data.nom}`;
                        selectTuteur(tuteurId, name);
                    }
                });
        }
    });

    // ── Autocomplete tuteur ──
    const searchInput = document.getElementById('sessionTuteurSearch');
    const dropdown    = document.getElementById('tuteurDropdown');
    const hint        = document.getElementById('tuteurHint');
    let debounce;

    searchInput.addEventListener('input', () => {
        clearTimeout(debounce);
        const q = searchInput.value.trim();
        if (q.length < 2) { dropdown.style.display = 'none'; return; }
        debounce = setTimeout(() => searchTuteurs(q), 350);
    });

    searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') dropdown.style.display = 'none';
    });

    document.addEventListener('click', (e) => {
        if (!e.target.closest('#tuteurDropdown') && e.target !== searchInput) {
            dropdown.style.display = 'none';
        }
    });

    async function searchTuteurs(q) {
        const json = await apiCall(`/api/matching?skill=${encodeURIComponent(q)}`);
        if (!json.success || !json.data.length) {
            dropdown.innerHTML = '<div style="padding:.75rem 1rem;color:var(--color-text-muted);font-size:var(--text-sm);">Aucun tuteur trouvé pour cette compétence.</div>';
            dropdown.style.display = 'block';
            return;
        }
        dropdown.innerHTML = '';
        json.data.slice(0, 8).forEach(match => {
            const u = match.user;
            const item = document.createElement('div');
            item.style.cssText = 'padding:.6rem 1rem;cursor:pointer;display:flex;align-items:center;gap:.6rem;font-size:var(--text-sm);border-bottom:1px solid var(--color-border-light);';
            item.innerHTML = `
                <div class="avatar avatar-xs avatar-placeholder" style="width:28px;height:28px;font-size:11px;flex-shrink:0">
                    ${(u.prenom||'')[0]||''}${(u.nom||'')[0]||''}
                </div>
                <div>
                    <strong>${u.fullName || u.prenom + ' ' + u.nom}</strong>
                    <span style="color:var(--color-text-muted);margin-left:.4rem;">${match.matchedSkill.nom}</span>
                </div>
                <span style="margin-left:auto;color:var(--color-primary);font-weight:600;">${match.score}%</span>`;
            item.addEventListener('mouseenter', () => item.style.background = 'var(--color-surface-alt)');
            item.addEventListener('mouseleave', () => item.style.background = '');
            item.addEventListener('click', () => {
                selectTuteur(u.id, u.fullName || u.prenom + ' ' + u.nom);
                document.getElementById('sessionCompetence').value = match.matchedSkill.nom;
            });
            dropdown.appendChild(item);
        });
        dropdown.style.display = 'block';
    }

    function selectTuteur(id, name) {
        document.getElementById('sessionTuteurId').value = id;
        searchInput.value = name;
        searchInput.readOnly = true;
        searchInput.style.background = 'var(--color-surface-alt)';
        dropdown.style.display = 'none';
        hint.innerHTML = `Tuteur sélectionné. <button type="button" onclick="resetTuteur()" style="background:none;border:none;color:var(--color-primary);cursor:pointer;padding:0;text-decoration:underline;">Changer</button>`;
    }

    window.resetTuteur = () => {
        document.getElementById('sessionTuteurId').value = '';
        searchInput.value = '';
        searchInput.readOnly = false;
        searchInput.style.background = '';
        hint.innerHTML = 'Recherchez par compétence pour trouver un tuteur disponible.';
        searchInput.focus();
    };

    document.getElementById('submitSession')?.addEventListener('click', async () => {
        const tuteurId  = document.getElementById('sessionTuteurId').value;
        const competence = document.getElementById('sessionCompetence').value.trim();
        const type      = document.getElementById('sessionType').value;
        const duree     = parseInt(document.getElementById('sessionDuree').value);
        const date      = document.getElementById('sessionDate').value;
        const lieu      = document.getElementById('sessionLieu').value;

        if (!tuteurId || !competence || !date) {
            showSessionAlert('error', 'Tuteur, compétence et date sont obligatoires.');
            return;
        }

        const res  = await apiFetch('/api/sessions', {
            method: 'POST',
            body: JSON.stringify({
                tuteur_id: parseInt(tuteurId),
                competence,
                type,
                date,
                duree_minutes: duree,
                lieu_ou_lien: lieu,
            })
        });
        const json = await res.json();
        if (json.success) {
            showSessionAlert('success', 'Session proposée ! En attente de confirmation.');
            setTimeout(() => window.location.href = '/sessions', 2000);
        } else {
            showSessionAlert('error', json.error);
        }
    });

    function showSessionAlert(type, msg) {
        const el = document.getElementById('sessionAlert');
        el.className = `alert alert-${type}`;
        el.textContent = msg;
        el.style.display = 'flex';
    }
</script>
{% endblock %}
